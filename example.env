# Minimal setup (sensible defaults are built in for everything else).
# Optional:
# ADDR=:3030

# Required for Plex access:
PLEX_BASE_URL=http://127.0.0.1:32400
PLEX_TOKEN=replace-with-your-token

# Alternative: use a Wrapster media gateway for Plex search/streaming.
# When both are set, the backend /libraries, /tracks, and /stream/:id routes use
# Wrapster's NIP-98 protected /media/api/services/plex/* routes instead of
# calling Plex directly. The big browser UI's /api/plex/* same-origin proxy still
# needs direct PLEX_BASE_URL access because Wrapster does not expose arbitrary
# Plex library browsing.
# WRAPSTER_MEDIA_URL=https://relay.example.org
# WRAPSTER_MEDIA_NSEC=nsec1...

# How to get PLEX_TOKEN (clear version):
#   1) Open https://app.plex.tv/desktop and sign in.
#   2) Press F12 (or Right click -> Inspect) to open DevTools.
#   3) Open the "Network" tab.
#   4) In Plex UI, click any library item so requests appear.
#   5) In Network list, click a request whose URL contains "/library/".
#   6) In request details, look for:
#        Query String Parameters -> X-Plex-Token
#      (or in Request URL: ...?X-Plex-Token=abc123...)
#   7) Copy only the token value.
#      Example:
#        Request URL: ...X-Plex-Token=abc123DEF456
#        Put this in .env: PLEX_TOKEN=abc123DEF456
#      Do NOT include "X-Plex-Token=" in the value.
#
# SESSION_SECRET is now auto-generated and persisted in SQLite:
#   data/plextr.sqlite3

# Optional — Music Assistant quick exploration
# MUSIC_ASSISTANT_BASE_URL=http://127.0.0.1:8095
# MUSIC_ASSISTANT_TOKEN=

# Optional Spotify public client ID and Apple MusicKit developer key:
# SPOTIFY_CLIENT_ID=
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY_PATH=/path/to/AuthKey.p8
